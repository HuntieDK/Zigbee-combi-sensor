# Target flash: XIAO ESP32-C6 has 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Zigbee: end device, native 802.15.4 radio (never a router)
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y

# Console / logging over the built-in USB-Serial-JTAG ONLY.
# GPIO16/17 (UART0 default) are used for the LD2410C, so the UART console must be off.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
